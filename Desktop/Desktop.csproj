    <EmbeddedResource Update="Views\IniciarSesionView.resx"><DependentUpon>IniciarSesionView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Views\MenuPrincipalView.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Views\MenuPrincipalView.Designer.cs"><DependentUpon>MenuPrincipalView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\MenuPrincipalView.resx"><DependentUpon>MenuPrincipalView.cs</DependentUpon></EmbeddedResource>
