    <EmbeddedResource Update="Views\FormatosView.resx"><DependentUpon>FormatosView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Views\VentasView.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Views\VentasView.Designer.cs"><DependentUpon>VentasView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Views\VentasView.resx"><DependentUpon>VentasView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ViewReports\ClientesViewReport.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ViewReports\ClientesViewReport.Designer.cs"><DependentUpon>ClientesViewReport.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ViewReports\ClientesViewReport.resx"><DependentUpon>ClientesViewReport.cs</DependentUpon></EmbeddedResource>
