    <EmbeddedResource Update="ViewReports\ProductosFiltradosViewReport.resx"><DependentUpon>ProductosFiltradosViewReport.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ViewReports\ProductosAgrupadosViewReport.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ViewReports\ProductosAgrupadosViewReport.Designer.cs"><DependentUpon>ProductosAgrupadosViewReport.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ViewReports\ProductosAgrupadosViewReport.resx"><DependentUpon>ProductosAgrupadosViewReport.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ViewReports\VentaComprobanteViewReport.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ViewReports\VentaComprobanteViewReport.Designer.cs"><DependentUpon>VentaComprobanteViewReport.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ViewReports\VentaComprobanteViewReport.resx"><DependentUpon>VentaComprobanteViewReport.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>

</Project>